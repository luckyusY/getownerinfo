{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/expire-listings",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/settle-pending",
      "schedule": "20 3 * * *"
    }
  ],
  "build": {
    "env": {
      "MONGOMS_DISABLE_POSTINSTALL": "1"
    }
  }
}
