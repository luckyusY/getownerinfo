# Copy to .env.local and fill in real values. .env.local is gitignored.

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/getownerinfo?retryWrites=true&w=majority"
MONGODB_DB="getownerinfo"

JWT_SECRET="<long-random-string>"
JWT_EXPIRES_IN="7d"

CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud-name>"

# Payment provider. AfriPay's checkout is a browser form POST authenticated by
# this app_id/app_secret pair (see src/lib/payments/afripay.js). Without BOTH of
# them the app falls back to a stub that auto-approves every payment.
AFRIPAY_APP_ID=""
AFRIPAY_APP_SECRET=""
AFRIPAY_SECRET=""   # reserved for webhook signatures, once AfriPay documents one

# Local overrides — both must stay UNSET in production.
#   PAYMENTS_PROVIDER=stub     simulate payments even with real credentials set
#   PAYMENTS_PROVIDER=afripay  force the real provider
#   PAYMENTS_PROVIDER=         (empty) pick automatically
# The stub is needed locally because a real AfriPay checkout cannot settle yet,
# so an unlock started against it would never complete. Forcing the stub is
# REFUSED in production unless PAYMENTS_ALLOW_STUB is explicitly "true".
PAYMENTS_PROVIDER=""
PAYMENTS_ALLOW_STUB=""

# Transactional email (unlock OTP codes). Without this, OTP-gated unlocks are
# refused in production rather than stranding the buyer at a code prompt.
RESEND_API_KEY=""
EMAIL_FROM="getownerinfo <noreply@yourdomain.com>"

# Optional: durable rate limiting across serverless instances. Falls back to
# per-instance in-memory limits when unset.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Guards the daily listing-expiry cron (see vercel.json). Without it the cron
# endpoint stays closed rather than open. Vercel Cron sends it as a Bearer token.
CRON_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth login. Callback URL:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
