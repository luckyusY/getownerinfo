# Copy to .env.local and fill in real values. .env.local is gitignored.

MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/getownerinfo?retryWrites=true&w=majority"
MONGODB_DB="getownerinfo"

JWT_SECRET="<long-random-string>"
JWT_EXPIRES_IN="7d"

CLOUDINARY_CLOUD_NAME="<cloud-name>"
CLOUDINARY_API_KEY="<api-key>"
CLOUDINARY_API_SECRET="<api-secret>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloud-name>"

AFRIPAY_BASE_URL=""
AFRIPAY_API_KEY=""
AFRIPAY_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth login. Callback URL:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
